# For Apache hosting (e.g. Hostinger Web Hosting). Copy into the folder that
# serves app.jjprivatetraining.com, next to index.html.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # THE_REQUEST is the original request line, so this still works after the SPA rewrite below.
  <If "%{THE_REQUEST} =~ m#^\S+\s+/(book|embed)#">
    Header always set Content-Security-Policy "frame-ancestors 'self' https://www.jjprivatetraining.com https://jjprivatetraining.com"
  </If>
  <Else>
    Header always set Content-Security-Policy "frame-ancestors 'self'"
  </Else>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
