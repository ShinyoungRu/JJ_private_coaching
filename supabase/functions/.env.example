# Edge Function secrets.
# Local:      copy to supabase/functions/.env  (git-ignored) and run
#             npx supabase functions serve --env-file supabase/functions/.env
# Production: npx supabase secrets set --env-file supabase/functions/.env.production
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by Supabase. Do not set them here.

# --- App ---------------------------------------------------------------------
APP_URL=https://app.jjprivatetraining.com
# Marketing site origins allowed to call public-availability, public-pricing, contact-form
PUBLIC_SITE_ORIGINS=https://www.jjprivatetraining.com,https://jjprivatetraining.com
# Extra origins for local testing only, comma separated (leave empty in production)
EXTRA_ALLOWED_ORIGINS=

# --- Stripe (TEST MODE) ------------------------------------------------------
# Live keys are refused unless STRIPE_ALLOW_LIVE=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_ALLOW_LIVE=false

# --- Email (Resend) ----------------------------------------------------------
# Leave RESEND_API_KEY empty locally to log emails instead of sending them.
RESEND_API_KEY=re_xxx
EMAIL_FROM=JJ Private Training <bookings@jjprivatetraining.com>
EMAIL_REPLY_TO=jjprivatetraining@gmail.com
COACH_NOTIFICATION_EMAIL=jjprivatetraining@gmail.com
# Optional: logo shown in email headers
# EMAIL_LOGO_URL=https://...

# --- Security ----------------------------------------------------------------
# Long random strings: openssl rand -hex 32
CRON_SECRET=change-me
RATE_LIMIT_SALT=change-me
